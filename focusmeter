#include <stdio.h>

#define MAX_ACTIVITIES 100

typedef struct {
    char name[100];
    int minutes;
    int category;
} Activity;

int main(void) {
    Activity log[MAX_ACTIVITIES];
    int count = 0;
    int choice;

    printf("\n===== FOCUSMETER =====\n");

    while (count < MAX_ACTIVITIES) {
        printf("\n1. Log activity\n");
        printf("2. View daily report\n");
        printf("3. Exit\n");
        printf("Choose: ");

        if (scanf("%d", &choice) != 1)
            break;

        if (choice == 3)
            break;

        if (choice == 1) {
            printf("Activity name (one word): ");
            scanf("%99s", log[count].name);

            printf("Minutes spent: ");
            if (scanf("%d", &log[count].minutes) != 1 ||
                log[count].minutes <= 0) {
                printf("Invalid duration.\n");
                break;
            }

            printf("\nCategory:\n");
            printf("1. Productive\n");
            printf("2. Intentional leisure\n");
            printf("3. Unplanned scrolling\n");
            printf("Choose category: ");

            if (scanf("%d", &log[count].category) != 1 ||
                log[count].category < 1 ||
                log[count].category > 3) {
                printf("Invalid category.\n");
                break;
            }

            count++;
            printf("Activity recorded!\n");
        }
        else if (choice == 2) {
            int productive = 0;
            int leisure = 0;
            int scrolling = 0;

            printf("\n===== DAILY REPORT =====\n");

            for (int i = 0; i < count; i++) {
                printf("%s: %d min\n",
                       log[i].name, log[i].minutes);

                if (log[i].category == 1)
                    productive += log[i].minutes;
                else if (log[i].category == 2)
                    leisure += log[i].minutes;
                else
                    scrolling += log[i].minutes;
            }

            printf("\nProductive: %d min\n", productive);
            printf("Intentional leisure: %d min\n", leisure);
            printf("Unplanned scrolling: %d min\n", scrolling);
            printf("Total tracked: %d min\n",
                   productive + leisure + scrolling);
        }
        else {
            printf("Invalid option.\n");
        }
    }

    printf("\nFocusMeter closed. Keep building!\n");
    return 0;
}
